# Environment mode: development | testing | production
ENVIRONMENT=development
DEBUG=True

# Online MongoDB Cluster Connection URI (MongoDB Atlas or remote cluster)
# Example: mongodb+srv://dbUser:SecurePassword123@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sanctum_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Google OAuth Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# University Email Domain Restriction (Strict matching)
ALLOWED_EMAIL_DOMAIN=ahduni.edu.in

# Session & Security
SESSION_SECRET=sanctum-ultra-secure-random-secret-key-32-chars-min
SESSION_COOKIE_NAME=sanctum_session
SESSION_EXPIRE_HOURS=72
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=lax

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Dev/Testing helper (Allows test sign-ins with @ahduni.edu.in; automatically disabled in production)
DEV_AUTH_ENABLED=True
